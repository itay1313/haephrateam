# Local development can point at any Postgres. In production these come from the
# Neon store connected to the Vercel project (prefix NEON_).
NEON_POSTGRES_PRISMA_URL="postgres://user:pass@host/db?sslmode=require"
NEON_POSTGRES_URL_NON_POOLING="postgres://user:pass@host/db?sslmode=require"

AUTH_SECRET="replace-with-a-long-random-string"
FAMILY_PASSWORD="13"

# Uploads go to a private Vercel Blob store when this is set,
# and to ./uploads when it is not.
BLOB_READ_WRITE_TOKEN=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://127.0.0.1:3000/api/google/callback"
